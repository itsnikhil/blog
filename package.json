{
  "name": "itsnikhil-blog",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/prepare-assets.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node scripts/verify-build.mjs && node scripts/verify-cactus.mjs && node scripts/verify-carousel.mjs && node scripts/verify-quality.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.7",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "astro-icon": "^1.2.0",
    "@iconify-json/mdi": "^1.2.2",
    "@pagefind/component-ui": "^1.5.2",
    "pagefind": "^1.5.2",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.9.1",
    "entities": "^9.0.0",
    "marked": "^17.0.1",
    "marked-highlight": "^2.2.3",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "@types/node": "^26.5.1",
    "jsdom": "^31.0.0",
    "@playwright/test": "^1.65.0"
  }
}
