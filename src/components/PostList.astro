---
import type {LegacyEntry} from '@/types';
interface Props {entries: LegacyEntry[]; summaries?: boolean;}
import {url} from '../lib/content.js';
const {entries, summaries=false} = Astro.props;
const date = (d: Date|null) => d?.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<ul class="post-list space-y-4" role="list">
{entries.map(p=><li class="grid gap-1 sm:grid-cols-[auto_1fr]">
 <time class="text-muted min-w-28 tabular-nums" datetime={p.date?.toISOString()}>{date(p.date)}</time>
 <div class="min-w-0"><a class="cactus-link" href={url(p.route)}>{p.title}</a>{summaries&&<p class="text-muted mt-2 leading-relaxed">{p.excerpt}</p>}</div>
</li>)}
</ul>
