---
import PageLayout from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import SocialList from '@/components/SocialList.astro';
import {posts,featured,url,description} from '@/lib/content.js';
---
<PageLayout meta={{title:'Home'}}>
 <section>
  <h1 class="title mb-12">Hi, I’m Nikhil.</h1>
  <p class="mb-4 leading-relaxed">{description}</p>
  <SocialList />
 </section>
 <section class="mt-16">
  <h2 class="title text-accent mb-6 text-xl"><a href={url('posts')}>Writings</a></h2>
  <PostList entries={posts.slice(0,10)}/>
  <p class="mt-6"><a class="cactus-link text-accent" href={url('posts')}>All writings →</a></p>
 </section>
 <section class="mt-16">
  <h2 class="title text-accent mb-6 text-xl"><a href={url('projects')}>Projects</a></h2>
  <ul class="space-y-6">{featured.map((p:{name:string;url:string;desc:string})=><li><a class="cactus-link font-semibold" href={p.url}>{p.name}</a><p class="text-muted mt-1 leading-relaxed">{p.desc}</p></li>)}</ul>
  <p class="mt-6"><a class="cactus-link text-accent" href={url('projects')}>All projects →</a></p>
 </section>
</PageLayout>
